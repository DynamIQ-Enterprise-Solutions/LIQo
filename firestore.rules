rules_version = '2';
// LIQo (P1-06A): browsers never read or write Firestore directly. Only the LIQo
// API on the server PC does, through the admin SDK, which these rules do not limit.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
