# Copy to .env and fill in. Never commit .env.

# SQL Server connection (local dev uses SQL auth).
DATABASE_SERVER=localhost
DATABASE_NAME=liqo
DATABASE_USER=liqo_app
DATABASE_PASSWORD=CHANGE_ME
# false for local SQL Server, true for Azure / managed SQL
DATABASE_ENCRYPT=false

# Secret used to sign login tokens. Any long random string. Required.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

PORT=3000

# Comma-separated browser origins allowed to call the API.
# Leave empty in development to allow any http://localhost:* origin.
CORS_ORIGINS=

# Set to "off" to disable rate limiting (tests only).
RATE_LIMIT=on

# AI floor-plan reading through IQGateway. Paste your own gws_ key here, server side only.
IQ_GATEWAY_KEY=
# Optional; defaults to https://iqlicense.dynamiqes.com/v1
IQ_GATEWAY_URL=

# DWG plans: full path to ODA File Converter (free from the Open Design Alliance;
# you accept its license when installing). Empty = DWG uploads are refused.
ODA_FILE_CONVERTER=
